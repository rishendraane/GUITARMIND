rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB max
        && request.resource.contentType.matches('image/.*');
    }
    
    // User guitar photos
    match /users/{userId}/guitars/{fileName} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024  // 10MB max
        && request.resource.contentType.matches('image/.*');
    }
    
    // Practice session recordings
    match /users/{userId}/recordings/{fileName} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024  // 50MB max
        && request.resource.contentType.matches('audio/.*');
    }
    
    // Share cards (generated achievement images)
    match /users/{userId}/share_cards/{fileName} {
      allow read: if true;  // Share cards are public
      allow write: if request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Public content (lessons, backing tracks)
    match /content/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;  // Admin only
    }
  }
}
